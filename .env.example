# Copy to .env next to compose.yaml. Compose substitutes these into the service
# environment; the app also reads a .env directly when run outside Docker.

# Scoring. This one is required — it is what picks the moments.
STREETCLIP_ANTHROPIC_API_KEY=

# Transcription: groq (hosted, ~$0.04/audio-hour) or local (faster-whisper, free).
STREETCLIP_TRANSCRIBE_BACKEND=groq
STREETCLIP_GROQ_API_KEY=
# Optional stable secret used to encrypt non-admin provider keys in SQLite.
# Without it, streetclip creates a protected secret inside the data volume.
# STREETCLIP_KEY_ENCRYPTION_SECRET=

# Only used when the backend is local. Larger is more accurate and much slower
# on CPU: tiny.en, base.en, small.en, medium.en, large-v3.
# STREETCLIP_LOCAL_WHISPER_MODEL=small.en
# STREETCLIP_EXTRAS=groq,reframe,local-whisper

# Host port to publish the UI on.
# STREETCLIP_BIND=8080

# Host storage paths used by compose.yaml. Keep database and scratch on local
# SSD; data and input may point at durable NFS mounts.
# STREETCLIP_INPUT_HOST_PATH=./input
# STREETCLIP_DATA_HOST_PATH=/mnt/nfs/streetclip/data
# STREETCLIP_DATABASE_HOST_PATH=/var/lib/streetclip
# STREETCLIP_SCRATCH_HOST_PATH=/var/cache/streetclip
